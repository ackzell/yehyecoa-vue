{
  "name": "yehyecoa-vue",
  "type": "module",
  "version": "0.1.0-beta",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && node scripts/minify-workers-post-build.js && npm run build-server && node scripts/compress-assets.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write src/",
    "install-in-amoxtli-vue": "rm -rf ../amoxtli-vue/src/templates/yehyecoa && cp -r dist/ ../amoxtli-vue/src/templates/yehyecoa",
    "bi": "npm run build && npm run install-in-amoxtli-vue",
    "build-server": "cp server.js dist/server.js",
    "serve": "node dist/server.js"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.13",
    "@iconify-json/mynaui": "^1.2.16",
    "@unocss/reset": "^66.4.2",
    "@vue/repl": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "lucide-vue-next": "^0.541.0",
    "pinia": "^3.0.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.7",
    "v-code-diff": "^1.13.1",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/components": "^13.8.0",
    "@vueuse/core": "^13.6.0",
    "@vueuse/rxjs": "^13.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "floating-vue": "^5.2.2",
    "glob": "^11.0.3",
    "jiti": "^2.4.2",
    "motion-v": "^1.7.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "reka-ui": "^2.5.0",
    "rxjs": "^7.8.2",
    "terser": "^5.43.1",
    "typescript": "~5.8.0",
    "unocss": "^66.4.2",
    "unocss-preset-animations": "^1.2.1",
    "unocss-preset-shadcn": "^1.0.1",
    "vite": "^7.0.6",
    "vite-plugin-package-version": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-tsc": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "v-code-diff"
    ]
  }
}
