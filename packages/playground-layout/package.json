{
  "name": "@calmecac-vue/playground-layout",
  "version": "0.1.0",
  "description": "Shared draggable/resizable panel dock + file tree layout for calmecac-vue playgrounds",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.39.3"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.44"
  }
}
